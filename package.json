{
  "name": "sipclub",
  "version": "1.0.0",
  "description": "Sip Pass coffee subscription platform (Monorepo: Frontend + Backend)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start:frontend": "npm start --prefix frontend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "start:backend": "npm run start:dev --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "test:backend": "npm test --prefix backend",
    "docker:up": "docker compose -f backend/docker-compose.yml up -d",
    "docker:down": "docker compose -f backend/docker-compose.yml down",
    "docker:build": "docker compose -f backend/docker-compose.yml up --build -d"
  }
}
