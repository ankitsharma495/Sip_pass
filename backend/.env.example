# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sipclub_dev?schema=public
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sipclub_dev
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=sipclub_access_secret_super_secure_key_2026_dev
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=sipclub_refresh_secret_super_secure_key_2026_dev
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=30

# OTP & Real SMS Gateway Configuration
OTP_EXPIRATION_SECONDS=300
OTP_MOCK_DEFAULT=4821
OTP_MAX_ATTEMPTS=5

# SMS Provider: 'fast2sms' or 'mock'
SMS_PROVIDER=fast2sms

# Paste your Fast2SMS API Key below (from fast2sms.com dashboard)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Comma-separated phone numbers that bypass real SMS and use OTP_MOCK_DEFAULT
OTP_TEST_NUMBERS=+919820451290
